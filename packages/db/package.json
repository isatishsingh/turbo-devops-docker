{
  "name": "@repo/db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "@repo/typescript-config": "*"
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "bun --bun run prisma generate",
    "db:migrate": "bun --bun run prisma migrate dev",
    "db:push": "bun --bun run prisma db push",
    "db:studio": "bun --bun run prisma studio"
  },
  "exports": {
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
